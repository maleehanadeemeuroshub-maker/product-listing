# These are provisioned automatically via Vercel Marketplace integrations
# (Shopify + Supabase) and pulled locally with `vercel env pull`.
# Copy this file to .env.local only if you need to set values manually.

# Shopify Storefront API — commerce (catalog, cart, checkout).
# Public-safe: the storefront token is designed for client-side use.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Supabase — auth, wishlist/compare persistence, avatar storage.
# Public-safe: the publishable key is designed for client-side use.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
