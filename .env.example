# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# Secret used to sign login JWTs. Any long random string works.
JWT_SECRET=replace-with-a-long-random-string

# The URL of the frontend, used to build links inside emails
# (verify-email, reset-password, view-order links).
CLIENT_URL=http://localhost:5173

# Port for the local API dev server (see server/dev.js).
PORT=8787

# Resend (https://resend.com) — Dashboard > API Keys > Create API Key.
# Leave empty to run in "dev inbox" mode: emails are saved locally and
# viewable at /dev/inbox instead of actually being sent.
RESEND_API_KEY=

# Resend's onboarding@resend.dev sender works without verifying a domain,
# but can only deliver to the email address you signed up to Resend with.
RESEND_FROM_EMAIL=Shoply <onboarding@resend.dev>
